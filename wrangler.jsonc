/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nutribox-frontend",
	"compatibility_date": "2025-04-04",
	"main": "./workers/app.ts",
	// Dev / local defaults -- override VENDURE_SHOP_API for production via:
	//   wrangler secret put VENDURE_SHOP_API
	// or add an [env.production] block below.
	"vars": {
		"VENDURE_SHOP_API": "http://localhost:3000/shop-api",
		// NOTE: these two do NOT reach SocialAuthButtons.tsx — that's client-side code
		// reading import.meta.env.VITE_*, which Vite resolves at BUILD time from the
		// frontend's own .env file, not from this Workers runtime config. Listed here
		// only for reference/consistency; the actual fix is the frontend .env entry.
		"VITE_GOOGLE_CLIENT_ID": "653181107786-n30fd2tconrqfgrdst1chkjd70sdt9oa.apps.googleusercontent.com",
		"VITE_FACEBOOK_APP_ID": "1488130163334894"
	},
	"observability": {
		"enabled": true,
	},
	"compatibility_flags": ["nodejs_compat"],
	// Smart Placement: routes each request to the datacenter closest to your
	// Vendure backend, reducing round-trip latency by 50-200 ms in production.
	"placement": { "mode": "smart" },
}