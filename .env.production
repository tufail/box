# Social login — must match the values configured on the Vendure backend
# (GOOGLE_CLIENT_ID / FACEBOOK_APP_ID in the nutrient repo's .env). Vite build-time
# vars, baked into the client bundle at build time — see app/components/SocialAuthButtons.tsx.
#
# Committed (unlike .env) because these are public OAuth client identifiers, not
# secrets — they're meant to ship in client-side code, and are already checked into
# wrangler.jsonc's `vars` for reference. The production build (react-router build,
# which runs Vite in "production" mode by default) needs its own copy of this file
# since Cloudflare's Workers Builds pipeline builds from a fresh git checkout, not
# from this machine's local .env — without this, the values are simply missing at
# build time and the client bundle ends up with the "not configured" fallback.
VITE_GOOGLE_CLIENT_ID=653181107786-n30fd2tconrqfgrdst1chkjd70sdt9oa.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=1488130163334894
